# Copie este arquivo para .env e ajuste os valores.
# O .env NÃO deve ser commitado (contém senha do banco).

# ----- Servidor web (porta SEPARADA do MecAuto/JJSoft) -----
OE_HOST=0.0.0.0
OE_PORTA=5055
OE_DEBUG=false
OE_SECRET_KEY=troque-por-uma-chave-aleatoria
OE_NOME_OFICINA=BF Trucks

# Rodapé do pedido de peças (setor de compras) — como no modelo da planilha
OE_RESPONSAVEL_COMPRAS=MARCOS NUNES
OE_TELEFONE_COMPRAS=44 9.8811-2977
OE_DEPARTAMENTO_COMPRAS=DPTO. DE COMPRAS

# ----- Banco Firebird 2.5 do MecAuto (CICOM.CDB) — SOMENTE LEITURA -----
# Enquanto MODO_DEMO=true, o sistema usa dados fictícios e não conecta em banco nenhum.
MECAUTO_MODO_DEMO=true

# DSN direto no servidor da rede. Exemplo: 192.168.1.250:C:\CICOM\MECAUTO\DB\CICOM.CDB
# Confirme o IP do servidor (ipconfig) e o caminho real do CICOM.CDB na sua oficina.
MECAUTO_DSN=

# Fallback opcional: se a conexão direta falhar (banco em uso), o sistema copia o
# .CDB para uma cópia local e conecta nela, para não brigar com o MecAuto em uso.
MECAUTO_CAMINHO_CDB_ORIGEM=
MECAUTO_CAMINHO_CDB_COPIA=
MECAUTO_DSN_COPIA=

MECAUTO_USUARIO=SYSDBA
MECAUTO_SENHA=masterkey
MECAUTO_CHARSET=WIN1252
# Caminho do fbclient.dll (Firebird 2.5), usado no Windows por fdb.load_api()
MECAUTO_FBCLIENT_DLL=C:\Program Files\Firebird\Firebird_2_5\bin\fbclient.dll
MECAUTO_TIMEOUT=10

# ----- Detecção de marcações (ajuste fino, opcional) -----
# OE_LIMIAR_MARCADO=0.18
# OE_LIMIAR_VAZIO=0.07
